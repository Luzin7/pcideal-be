PORT=8080
DATABASE_URL=mongodb://localhost:27017
PCIDEAL_DB_NAME=pcideal
SCRAPER_API_URL=http://localhost:3001
SCRAPER_API_KEY=
# Origens de CORS separadas por vírgula, como origens absolutas (esquema://host).
# Vazio usa o padrão de produção: https://pcideal-web.vercel.app.
# Desenvolvimento local pode definir http://localhost:3000 no .env não versionado,
# nunca em produção.
CORS_ALLOWED_ORIGINS=
# CIDRs do proxy reverso separados por vírgula (ex.: 10.0.0.0/8,203.0.113.7/32).
# Vazio ignora X-Forwarded-For. Em produção, vazio faz todos os clientes atrás
# do proxy compartilharem o mesmo bucket de rate limit; o boot registra um WARNING.
TRUSTED_PROXIES=
# Header do IP real do cliente, ex.: CF-Connecting-IP atrás do Cloudflare.
# Só habilite atrás de uma borda que sobrescreve o header. Vazio usa o ClientIP do Gin.
CLIENT_IP_HEADER=
ENV=development
